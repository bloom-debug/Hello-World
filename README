  <meta charset="UTF-8">
  <title>Cartoon Image Effect</title>
  <style>
    body {
      background: #111;
      color: #fff;
      text-align: center;
      font-family: sans-serif;
    }
    canvas {
      margin-top: 20px;
      border-radius: 12px;
    }
  </style>
</head>
<body>

<h2>🎨 Cartoon Image Effect (JavaScript)</h2>
<input type="file" id="upload" accept="image/*">
<br>
<canvas id="canvas"></canvas>

<script>
const upload = document.getElementById("upload");
const canvas = document.getElementById("canvas");
const ctx = canvas.getContext("2d");

upload.addEventListener("change", (e) => {
  const file = e.target.files[0];
  const img = new Image();

  img.onload = () => {
    canvas.width = img.width;
    canvas.height = img.height;
    ctx.drawImage(img, 0, 0);

    cartoonEffect();
  };

  img.src = URL.createObjectURL(file);
});

function cartoonEffect() {
  const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
  const data = imageData.data;

  for (let i = 0; i < data.length; i += 4) {
    // Increase contrast
    data[i]     = clamp((data[i] - 128) * 1.4 + 128);     // Red
    data[i + 1] = clamp((data[i + 1] - 128) * 1.4 + 128); // Green
    data[i + 2] = clamp((data[i + 2] - 128) * 1.4 + 128); // Blue

    // Color quantization (cartoon look)
    data[i]     = Math.round(data[i] / 32) * 32;
    data[i + 1] = Math.round(data[i + 1] / 32) * 32;
    data[i + 2] = Math.round(data[i + 2] / 32) * 32;
  }

  ctx.putImageData(imageData, 0, 0);
}

function clamp(value) {
  return Math.max(0, Math.min(255, value));
}
</script>

</body>
</html>


